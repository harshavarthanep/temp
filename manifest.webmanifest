{
  "name": "ZenPDF Studio",
  "short_name": "ZenPDF",
  "description": "Edit, organize, merge, split, watermark and convert PDFs — 100% in your browser. Your files never leave your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#f5f5f7",
  "theme_color": "#1d1d1f",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "./zenpdf-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./zenpdf-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./zenpdf-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
